{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ellen-in-politics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Requires elleninpolitics.com as an active Cloudflare zone (nameservers on Cloudflare).
  "routes": [
    { "pattern": "elleninpolitics.com", "custom_domain": true },
    { "pattern": "www.elleninpolitics.com", "custom_domain": true }
  ]
}
