{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ellen-in-politics",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // After the domain is on Cloudflare DNS, uncomment and set:
  // "routes": [{ "pattern": "ellencarty.com", "custom_domain": true }]
}
